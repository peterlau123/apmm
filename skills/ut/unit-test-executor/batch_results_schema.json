{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Batch Results Schema",
  "description": "批次测试执行结果文件格式 - batch_results.json",
  "version": "2.0",
  "type": "object",
  "required": ["batch_id", "executed_at", "tests", "stats"],
  "properties": {
    "batch_id": {
      "type": "string",
      "description": "批次唯一标识",
      "pattern": "^batch_[0-9]{8}_[0-9]{6}$"
    },
    "executed_at": {
      "type": "string",
      "format": "date-time",
      "description": "执行完成时间 (ISO 8601)"
    },
    "tests": {
      "type": "array",
      "description": "执行结果详情列表",
      "items": {
        "type": "object",
        "required": ["test_node", "status"],
        "properties": {
          "test_node": {
            "type": "string",
            "description": "pytest测试节点"
          },
          "status": {
            "type": "string",
            "description": "执行状态",
            "enum": ["passed", "failed", "error"],
            "_enum_comments": {
              "passed": "测试通过",
              "failed": "断言失败（AssertionError）",
              "error": "执行错误（Collection/Import/Download）"
            }
          },
          "error_type": {
            "type": ["string", "null"],
            "description": "错误类型分类",
            "enum": ["dependency", "network", "resource", "version", "functional", "download_error", "other", null],
            "_enum_comments": {
              "dependency": "依赖缺失 (ImportError, ModuleNotFoundError)",
              "network": "网络错误 (ConnectionError, HTTP 503/404)",
              "resource": "资源不足 (CUDA OOM, GPU 不可用)",
              "version": "版本兼容问题 (vLLM v0.13.0 + PyTorch 2.5.1 兼容性)",
              "functional": "功能错误 (AssertionError, ValueError)",
              "download_error": "模型下载失败 (Model not found, config.json missing)",
              "other": "其他错误 (未分类的错误类型)",
              "null": "无错误"
            }
          },
          "error_message": {
            "type": ["string", "null"],
            "description": "错误信息摘要(最多500字符)"
          },
          "duration_ms": {
            "type": ["integer", "null"],
            "description": "执行耗时(毫秒)"
          },
          "exit_code": {
            "type": ["integer", "null"],
            "description": "pytest退出码"
          }
        }
      }
    },
    "stats": {
      "type": "object",
      "description": "执行统计",
      "required": ["passed", "failed", "error", "total"],
      "properties": {
        "passed": {"type": "integer", "minimum": 0, "description": "通过数"},
        "failed": {"type": "integer", "minimum": 0, "description": "失败数(断言错误)"},
        "error": {"type": "integer", "minimum": 0, "description": "错误数(收集/执行错误)"},
        "total": {"type": "integer", "minimum": 0, "description": "总测试数"}
      }
    },
    "log_file": {
      "type": "string",
      "description": "日志文件路径"
    }
  }
}