{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Batch Config Schema",
  "description": "批次测试配置文件格式 - batch_config.json",
  "version": "2.0",
  "type": "object",
  "required": ["batch_id", "tests", "distributed_count", "generated_at"],
  "properties": {
    "batch_id": {
      "type": "string",
      "description": "批次唯一标识，格式: batch_{YYYYMMDD_HHMMSS}",
      "pattern": "^batch_[0-9]{8}_[0-9]{6}$"
    },
    "tests": {
      "type": "array",
      "description": "本批次待执行的测试列表",
      "items": {
        "type": "object",
        "required": ["id", "test_node", "test_file", "test_name", "status"],
        "properties": {
          "id": {"type": "integer", "minimum": 1, "description": "测试序号"},
          "test_node": {"type": "string", "description": "pytest测试节点 (tests/test_file.py::TestClass::test_method)"},
          "test_file": {"type": "string", "description": "测试文件路径 (tests/test_file.py)"},
          "test_name": {"type": "string", "description": "测试方法名 (test_method)"},
          "status": {
            "type": "string",
            "enum": ["pending"],
            "description": "测试状态",
            "_enum_comments": {
              "pending": "待执行"
            }
          }
        }
      }
    },
    "distributed_count": {
      "type": "integer",
      "description": "distributed 测试数量（需要多GPU）",
      "minimum": 0
    },
    "requires_multi_gpu": {
      "type": "boolean",
      "description": "是否需要多GPU执行"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "生成时间 (ISO 8601)"
    },
    "distributed_tests": {
      "type": "array",
      "description": "distributed 测试列表（最多显示前10个）",
      "items": {
        "type": "object",
        "properties": {
          "test_node": {"type": "string"},
          "id": {"type": "integer"}
        }
      }
    },
    "note": {
      "type": "string",
      "description": "提示信息，如 'distributed tests require GPU >= 2'"
    }
  }
}