{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UT Test Manifest Schema",
  "description": "vLLM单元测试清单文件格式定义",
  "version": "2.0",
  "type": "object",
  "required": ["version", "generated_at", "source", "tests", "statistics"],
  "properties": {
    "version": {
      "type": "string",
      "description": "manifest版本号",
      "enum": ["1.0", "2.0"],
      "default": "2.0",
      "_enum_comments": {
        "1.0": "旧版本格式（已废弃）",
        "2.0": "当前版本格式"
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "生成时间 (ISO 8601)"
    },
    "source": {
      "type": "string",
      "description": "数据来源",
      "enum": ["pytest_collect", "test_list_file", "manual"],
      "_enum_comments": {
        "pytest_collect": "通过pytest --collect-only生成",
        "test_list_file": "从用户指定的test_list.txt读取",
        "manual": "手动创建"
      }
    },
    "config": {
      "type": "object",
      "description": "Workflow配置引用",
      "properties": {
        "workflow_yaml": {
          "type": "string",
          "description": "workflow.yaml路径"
        },
        "run_dir": {
          "type": "string",
          "description": "运行目录路径"
        }
      }
    },
    "tests": {
      "type": "array",
      "description": "测试列表",
      "items": {
        "type": "object",
        "required": ["id", "test_node", "test_file", "test_name", "status"],
        "properties": {
          "id": {
            "type": "integer",
            "description": "测试序号",
            "minimum": 1
          },
          "test_node": {
            "type": "string",
            "description": "pytest测试节点 (tests/test_file.py::TestClass::test_method)"
          },
          "test_file": {
            "type": "string",
            "description": "测试文件路径 (tests/test_file.py)"
          },
          "test_name": {
            "type": "string",
            "description": "测试方法名 (test_method)"
          },
          "status": {
            "type": "string",
            "description": "测试状态",
            "enum": ["pending", "running", "passed", "failed", "error", "ignored", "fixed_pending_verify", "retriable_error"],
            "default": "pending",
            "_enum_comments": {
              "pending": "待执行",
              "running": "正在执行",
              "passed": "测试通过",
              "failed": "断言失败（AssertionError）",
              "error": "执行错误（Collection/Import/Download）",
              "fixed_pending_verify": "已修复待验证（修复后需要重新执行验证）",
              "retriable_error": "可重试的瞬态错误（OOM/Timeout）"
            }
          },
          "priority": {
            "type": "string",
            "description": "优先级",
            "enum": ["P0", "P1", "P2", "P3"],
            "default": "P2",
            "_enum_comments": {
              "P0": "最高优先级（关键测试）",
              "P1": "高优先级",
              "P2": "普通优先级（默认）",
              "P3": "低优先级"
            }
          },
          "batch_id": {
            "type": ["string", "null"],
            "description": "所属批次ID"
          },
          "last_batch_id": {
            "type": ["string", "null"],
            "description": "最后一次执行所属批次ID（远端日志指针）"
          },
          "run_count": {
            "type": "integer",
            "description": "执行次数",
            "default": 0,
            "minimum": 0
          },
          "retry_count": {
            "type": "integer",
            "description": "重试次数（用于batch-selector过滤）",
            "default": 0,
            "minimum": 0
          },
          "max_retry": {
            "type": "integer",
            "description": "最大重试次数（从workflow.yaml读取）",
            "default": 3,
            "minimum": 0
          },
          "last_run_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "最后执行时间"
          },
          "last_duration_ms": {
            "type": ["integer", "null"],
            "description": "最后执行耗时(毫秒)"
          },
          "last_exit_code": {
            "type": ["integer", "null"],
            "description": "最后执行退出码"
          },
          "error_type": {
            "type": ["string", "null"],
            "description": "错误类型分类",
            "enum": ["dependency", "network", "resource", "version", "functional", "download_error", "oom", "timeout", "other", null],
            "_enum_comments": {
              "dependency": "依赖缺失 (ImportError, ModuleNotFoundError)",
              "network": "网络错误 (ConnectionError, HTTP 503/404)",
              "resource": "资源不足 (CUDA OOM, GPU 不可用)",
              "version": "版本兼容问题 (vLLM v0.13.0 + PyTorch 2.5.1 兼容性)",
              "functional": "功能错误 (AssertionError, ValueError)",
              "download_error": "模型下载失败 (Model not found, config.json missing)",
              "other": "其他错误 (未分类的错误类型)",
              "null": "无错误"
            }
          },
          "error_message": {
            "type": ["string", "null"],
            "description": "错误信息摘要(最多500字符)"
          },
          "ignored_reason": {
            "type": ["string", "null"],
            "description": "忽略原因"
          },
          "fix_applied": {
            "type": "boolean",
            "description": "是否已应用修复",
            "default": false
          },
          "fix_details": {
            "type": ["string", "null"],
            "description": "修复详情"
          },
          "log_file": {
            "type": ["string", "null"],
            "description": "日志文件路径"
          },
          "errors": {
            "type": "array",
            "description": "错误历史追踪（环境问题：dependency, network, resource等）",
            "items": {
              "type": "object",
              "required": ["error_key", "error_type", "status"],
              "properties": {
                "error_key": {
                  "type": "string",
                  "description": "标准化错误标识",
                  "_examples": ["transformers", "meta-llama/Llama-3.2-1B", "torch.softmax.dim_arg"]
                },
                "error_type": {
                  "type": "string",
                  "description": "错误类型",
                  "enum": ["dependency", "download_error", "version", "network", "resource", "other"]
                },
                "error_message": {
                  "type": "string",
                  "description": "错误信息摘要（最多500字符）"
                },
                "status": {
                  "type": "string",
                  "description": "错误解决状态",
                  "enum": ["pending", "resolved"]
                },
                "occurred_at": {
                  "type": "string",
                  "format": "date-time",
                  "description": "首次发生时间"
                },
                "resolved_at": {
                  "type": ["string", "null"],
                  "format": "date-time",
                  "description": "解决时间（status=resolved 时）"
                }
              }
            }
          },
          "failures": {
            "type": "array",
            "description": "断言失败历史追踪（pytest FAILED）",
            "items": {
              "type": "object",
              "required": ["failure_key", "failure_type", "status"],
              "properties": {
                "failure_key": {
                  "type": "string",
                  "description": "标准化失败标识",
                  "pattern": "^\\w+:\\w+$",
                  "_examples": ["test_load:shape_mismatch", "test_inference:value_tolerance"]
                },
                "failure_type": {
                  "type": "string",
                  "description": "失败类型",
                  "enum": ["assertion"]
                },
                "failure_message": {
                  "type": "string",
                  "description": "断言信息摘要"
                },
                "status": {
                  "type": "string",
                  "description": "失败解决状态",
                  "enum": ["pending", "resolved"]
                },
                "commit": {
                  "type": ["string", "null"],
                  "description": "修复 commit 号"
                },
                "occurred_at": {
                  "type": "string",
                  "format": "date-time",
                  "description": "首次发生时间"
                },
                "resolved_at": {
                  "type": ["string", "null"],
                  "format": "date-time",
                  "description": "解决时间"
                }
              }
            }
          }
        }
      }
    },
    "resolved_errors": {
      "type": "object",
      "description": "已解决错误聚合索引（按需统计，用于快速判断是否跳过处理）",
      "additionalProperties": {
        "type": "object",
        "required": ["type", "resolved_at"],
        "properties": {
          "type": {
            "type": "string",
            "description": "错误类型",
            "enum": ["dependency", "download_error", "version", "network", "resource", "other"]
          },
          "resolved_at": {
            "type": "string",
            "format": "date-time",
            "description": "解决时间"
          }
        }
      },
      "_examples": {
        "transformers": {
          "type": "dependency",
          "resolved_at": "2026-06-12T15:00:00Z"
        }
      }
    },
    "resolved_failures": {
      "type": "object",
      "description": "已解决失败聚合索引（按需统计，用于快速判断是否跳过处理）",
      "additionalProperties": {
        "type": "object",
        "required": ["type", "resolved_at"],
        "properties": {
          "type": {
            "type": "string",
            "description": "失败类型",
            "enum": ["assertion"]
          },
          "resolved_at": {
            "type": "string",
            "format": "date-time",
            "description": "解决时间"
          },
          "commit": {
            "type": ["string", "null"],
            "description": "修复 commit 号"
          }
        }
      },
      "_examples": {
        "test_load:shape_mismatch": {
          "type": "assertion",
          "resolved_at": "2026-06-12T16:00:00Z",
          "commit": "a1b2c3d"
        }
      }
    },
    "statistics": {
      "type": "object",
      "description": "统计数据",
      "required": ["total", "pending"],
      "properties": {
        "total": {
          "type": "integer",
          "description": "总测试数",
          "minimum": 0
        },
        "executed": {
          "type": "integer",
          "description": "已执行数 (passed + failed + error + ignored)",
          "minimum": 0,
          "default": 0
        },
        "progress": {
          "type": "number",
          "description": "进度百分比",
          "minimum": 0,
          "maximum": 100,
          "default": 0
        },
        "passed": {
          "type": "integer",
          "description": "通过数",
          "minimum": 0,
          "default": 0
        },
        "failed": {
          "type": "integer",
          "description": "失败数(断言错误)",
          "minimum": 0,
          "default": 0
        },
        "error": {
          "type": "integer",
          "description": "错误数(收集/执行错误)",
          "minimum": 0,
          "default": 0
        },
        "ignored": {
          "type": "integer",
          "description": "忽略数",
          "minimum": 0,
          "default": 0
        },
        "pending": {
          "type": "integer",
          "description": "待执行数",
          "minimum": 0
        },
        "pass_rate": {
          "type": "number",
          "description": "通过率",
          "minimum": 0,
          "maximum": 100,
          "default": 0
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "元数据",
      "properties": {
        "vllm_version": {
          "type": "string",
          "description": "vLLM版本"
        },
        "torch_version": {
          "type": "string",
          "description": "PyTorch版本"
        },
        "python_version": {
          "type": "string",
          "description": "Python版本"
        },
        "platform": {
          "type": "string",
          "description": "平台信息"
        },
        "gpu_info": {
          "type": "string",
          "description": "GPU信息"
        },
        "notes": {
          "type": "string",
          "description": "备注"
        }
      }
    }
  }
}